# Git
.git/

# IDE and System
.idea
.DS_Store
*.iml

# Gradle and Build Artifacts
.gradle/
build/
**/build/
captures/
.externalNativeBuild/

# Sensitive Configuration & Secrets (Priority per AGENTS.md)
# Prevents AI from reading or accidentally suggesting edits to secrets
.env
local.properties
gradle.properties
google-services.json
key.properties
*.jks
*.keystore
*.p12

# Executables and Binaries
*.apk
*.aab
*.jar

# Large Media Files (Context Optimization)
# Since this is a media player, we don't want AI context filled with video binaries
*.mp4
*.mkv
*.avi
*.mov
*.mp3
*.flac
*.png
*.jpg
*.jpeg

# Documentation generated by code
javadoc/
